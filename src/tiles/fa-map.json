{
  "_uitleg": "Koppeling tegel-id -> mappen en bestandsnamen in Forgotten Adventures. Algemeen, niet per campagne. 'dir' = map (met submappen), 'match' = begin van de bestandsnaam (regex), 'exclude' = bestandsnamen die niet mogen.",
  "deny": "mushroom|fung|shroom|spore|mycel|mould|mold|(^|_)rats?(_|\\.|$)|gore|flesh|feces|blood|corpse|torture",
  "pxPerCell": 200,
  "themes": {
    "standaard": { "decor": 0.2, "prefer": ["Ashen", "Earthy"], "avoid": ["Broken", "Rusty", "Fallen", "Leaking", "Damaged", "Ripped", "Burnt", "Rotten", "Fancy"] },
    "rijk": { "decor": 0.08, "prefer": ["Fancy", "Walnut", "Red", "Gold", "Brass", "Polished", "Marble"], "avoid": ["Broken", "Rusty", "Fallen", "Leaking", "Damaged", "Ripped", "Burnt", "Rotten"] },
    "verlaten": { "decor": 0.4, "prefer": ["Broken", "Rusty", "Fallen", "Damaged", "Leaking", "Ripped", "Rotten", "Dark"], "avoid": ["Fancy", "Gold", "Polished"] }
  },
  "wall": {
    "_uitleg": "Props die tegen een muur horen. Staat er een muur naast het vakje (en geeft de DM geen 'rot'), dan draait de app de prop naar die muur en schuift ze ertegen. 'prefer' = kies liefst bestanden met dit woord.",
    "ladder": { "prefer": "Wall" },
    "bookshelf": {},
    "cupboard": {},
    "fireplace": {},
    "weapon-rack": {}
  },
  "props": {
    "table":     [{ "dir": "!Core_Settlements/Furniture/Tables", "match": "^(Round_|Square_|Long_|Dining_|Rectangle_|Rustic_)?Table_" }],
    "chair":     [{ "dir": "!Core_Settlements/Furniture/Seating/Chairs", "match": "^Chair_" }],
    "bench":     [{ "dir": "!Core_Settlements/Furniture/Seating/Benches", "match": "^Bench_" }],
    "bed":       [{ "dir": "!Core_Settlements/Furniture/Bedding/Beds/Single_Beds", "match": "^Single_Bed_" }],
    "chest":     [{ "dir": "!Core_Settlements/Decor/Storage/Chests", "match": "^Chest_" }],
    "barrel":    [{ "dir": "!Core_Settlements/Decor/Storage/Barrels", "match": "^Barrel_", "exclude": "Lid|Large|Side|Torture|Stand" }],
    "crate":     [{ "dir": "!Core_Settlements/Decor/Storage/Boxes_and_Crates/Crates", "match": "^Crate_" }],
    "bookshelf": [{ "dir": "!Core_Settlements/Furniture/Shelves/Bookshelves", "match": "^Bookshelf_" }],
    "cupboard":  [{ "dir": "!Core_Settlements/Furniture/Cupboards_and_Wardrobes", "match": "^Cupboard_" }],
    "counter":   [{ "dir": "!Core_Settlements/Furniture/Tables/Bars_and_Counters", "match": "^(Bar|Counter)" }],
    "fireplace": [{ "dir": "!Core_Settlements/Structures/Building/Fireplaces", "match": "^Fireplace_", "exclude": "Accessor|Poker|Tool" }],
    "oven":      [{ "dir": "!Core_Settlements/Furniture/Cooking_Appliances", "match": "Oven", "exclude": "Shovel" }],
    "rug":       [{ "dir": "!Core_Settlements/Decor/Rugs_and_Carpets/Rugs/Rectangle", "match": "^Rug_", "exclude": "Rolled" }],
    "stairs-up":   [{ "dir": "!Core_Settlements/Structures/Building/Stairs_and_Ladders/Stairs_Wood", "match": "^Stairs_Wood_[A-Za-z]+_[A-Z]\\d*_" }],
    "stairs-down": [{ "dir": "!Core_Settlements/Structures/Building/Stairs_and_Ladders/Stairs_Stone", "match": "^Stairs_Stone_[A-Za-z]+_[A-Z]\\d*_" }],
    "ladder":    [{ "dir": "!Core_Settlements/Structures/Building/Stairs_and_Ladders/Ladders", "match": "^Ladder_" }],
    "pillar":    [{ "dir": "!Core_Settlements/Structures/Building/Pillars", "match": "^Pillar_", "exclude": "Connector" }],
    "statue":    [{ "dir": "!Core_Settlements/Structures/Statues", "match": "^Statue_" }],
    "altar":     [{ "dir": "!Core_Settlements/Furniture/Altars", "match": "^Altar_" }],
    "well":      [{ "dir": "!Core_Settlements/Structures/Water_Structures/Wells", "match": "^Well_", "exclude": "Cover" }],
    "trough":    [{ "dir": "!Core_Settlements/Workplace_Equipment/Farming/Husbandry/Troughs", "match": "^Trough_" }],
    "rubble":    [{ "dir": "!Core_Settlements/Structures/Rubble/Rubble_Piles", "match": "^Rubble" }],
    "bell":      [{ "dir": "!Core_Settlements/Structures/Mechanical_Parts/Bells", "match": "^Bell_" }],
    "tree":      [{ "dir": "Woodlands/!Wilderness/Flora/Trees", "match": "^Tree_", "exclude": "Shadow|Branch|Stump|Log" }],
    "bush":      [{ "dir": "Woodlands/!Wilderness/Flora/Bushes", "match": "^Bush" }],
    "rock":      [{ "dir": "Mountain/!Wilderness/Decor/Rocks", "match": "^Rock_", "exclude": "Pile_Grave" }],
    "boulder":   [{ "dir": "Woodlands/!Wilderness/Decor/Rocks/Boulders", "match": "^Boulder_" }, { "dir": "Mountain/!Wilderness/Decor/Rocks/Boulders", "match": "^Boulder_" }],
    "log":       [{ "dir": "Woodlands/!Wilderness/Flora/Trees/Logs", "match": "^Log" }],
    "reeds":     [{ "dir": "Woodlands/!Wilderness/Flora/Plants/Long_Grass", "match": "." }],
    "flowers":   [{ "dir": "Woodlands/!Wilderness/Flora", "match": "^Flower" }, { "dir": "Feywilds/!Wilderness/Flora/Flowers", "match": "^Flower" }],
    "stone-circle-stone": [{ "dir": "Mountain/!Wilderness/Decor/Rocks/Stones", "match": "." }],
    "campfire":  [{ "dir": "!Core_Settlements/Lightsources/Campfires_and_Firepits", "match": "^Campfire_" }],
    "sacks":     [{ "dir": "!Core_Settlements/Decor/Storage/Sacks", "match": "^Sack_", "exclude": "Open_Transparent" }],
    "hay":       [{ "dir": "!Core_Settlements/Natural_Decor/Hay", "match": "^Hay_" }],
    "cart":      [{ "dir": "!Core_Settlements/Vehicles/Carts_and_Wagons", "match": "^Cart_", "exclude": "Wheel" }],
    "lantern":   [{ "dir": "!Core_Settlements/Lightsources/Lanterns", "match": "^Lantern_", "exclude": "_of_" }],
    "candle":    [{ "dir": "!Core_Settlements/Lightsources/Candles", "match": "^Candle_", "exclude": "_of_|Snuffer" }],
    "brazier":   [{ "dir": "!Core_Settlements/Lightsources/Braziers", "match": "^Brazier_", "exclude": "_of_" }],
    "bones":     [{ "dir": "Woodlands/!Wilderness/Decor/Bones", "match": "^Bone" }, { "dir": "!Core_Settlements/Burial_and_Graves", "match": "^Bone" }],
    "weapon-rack": [{ "dir": "!Core_Settlements/Combat/Weapons/Weapon_Racks", "match": "^Weapon_Rack_" }],
    "anvil":     [{ "dir": "!Core_Settlements/Workplace_Equipment/Smithing", "match": "^Anvil" }]
  },
  "walls": {
    "_uitleg": "Muren: 'match' = lange strook die herhaald wordt langs de muur, 'connector' = hoekstuk op elk knikpunt en uiteinde.",
    "stone":  [{ "dir": "!Core_Settlements/Structures/Building/Walls_and_Curbs/Wall_Stone_A", "match": "^Wall_Stone_.*_A_Straight_Path\\.png$", "connector": "^Wall_Stone_.*_A_Connector_A_1x1\\.png$" }],
    "wood":   [{ "dir": "!Core_Settlements/Structures/Building/Walls_and_Curbs/Wall_Wood_A", "match": "^Wall_Wood_.*_A_Straight_Path\\.png$", "connector": "^Wall_Wood_.*_A_Connector_A_1x1\\.png$" }],
    "brick":  [{ "dir": "!Core_Settlements/Structures/Building/Walls_and_Curbs/Wall_Brick_A", "match": "^Wall_Brick_.*_A_Straight_Path\\.png$", "connector": "^Wall_Brick_.*_A_Connector_A_1x1\\.png$" }],
    "fence":  [{ "dir": "!Core_Settlements/Structures/Building/Railings_and_Fences/Fence_Wood_A", "match": "^Fence_Wood_.*_Path\\.png$" }],
    "hedge":  [{ "dir": "Woodlands/Botanical_Garden_Settlement/Structures/Hedgemaze", "match": "_Path\\.png$" }]
  },
  "doors": {
    "_uitleg": "Deuren, poorten en ramen op de rand van een vakje. Regels zonder 'part' zijn het deurblad; 'part': 'frame' is het kozijn (3 vakjes breed, valt over de muur).",
    "door-wood":  [{ "dir": "!Core_Settlements/Structures/Building/Doors", "match": "^Door_Wood_.*_1x1\\.png$" },
                   { "dir": "!Core_Settlements/Structures/Building/Doors/Door_Frames", "match": "^Door_Frame_Wood_.*_3x1\\.png$", "part": "frame" }],
    "door-iron":  [{ "dir": "!Core_Settlements/Structures/Building/Doors", "match": "^Door_Metal_.*_1x1\\.png$" },
                   { "dir": "!Core_Settlements/Structures/Building/Doors/Door_Frames", "match": "^Door_Frame_Metal_.*_3x1\\.png$", "part": "frame" }],
    "gate":       [{ "dir": "!Core_Settlements/Structures/Building/Doors/Large_Doors", "match": "^Door_Large_Wood_" }],
    "portcullis": [{ "dir": "!Core_Settlements/Structures/Building/Doors/Large_Doors", "match": "^Portcullis_" }],
    "window":     [{ "dir": "!Core_Settlements/Structures/Building/Windows", "match": "^Window_Wood_.*_1x1\\.png$" }]
  },
  "decor": {
    "_uitleg": "Kleine versiering die de app zelf strooit op natuurlijke vloeren (alleen 1x1-bestanden). Hoeveel: 'decor' per sfeer hierboven (deel van de vakjes).",
    "dirt":   [{ "dir": "Woodlands/!Wilderness/Flora/Sticks_Twigs_Branches/Twigs", "match": "^Twig_.*_1x1\\.png$" },
               { "dir": "Woodlands/!Wilderness/Flora/Leaves", "match": "^Fallen_Leaf_.*_1x1\\.png$" },
               { "dir": "Mountain/!Wilderness/Decor/Rocks/Pebbles", "match": "^Pebble_.*_1x1\\.png$" }],
    "grass":  [{ "dir": "Woodlands/!Wilderness/Flora/Weeds", "match": "^Weed_.*_1x1\\.png$" },
               { "dir": "Woodlands/!Wilderness/Flora/Grass", "match": "^Grass_Patch_.*_1x1\\.png$" },
               { "dir": "Woodlands/!Wilderness/Flora/Leaves", "match": "^Fallen_Leaf_.*_1x1\\.png$" }],
    "cobble": [{ "dir": "Woodlands/!Wilderness/Flora/Leaves", "match": "^Fallen_Leaf_.*_1x1\\.png$" },
               { "dir": "Woodlands/!Wilderness/Flora/Sticks_Twigs_Branches/Twigs", "match": "^Twig_.*_1x1\\.png$" }],
    "sand":   [{ "dir": "Mountain/!Wilderness/Decor/Rocks/Pebbles", "match": "^Pebble_.*_1x1\\.png$" }]
  },
  "floor": {
    "wood":   [{ "dir": "!Core_Settlements/Textures/Wooden_Floors", "match": "^Wooden_Flooring_" }],
    "stone":  [{ "dir": "!Core_Settlements/Textures/Stone_Floors", "match": "^Flat_Stone_Floor_", "ext": "jpg" }],
    "cobble": [{ "dir": "!Core_Settlements/Textures/Stone_Floors", "match": "^Cobblestone_A_\\d", "ext": "jpg" }],
    "dirt":   [{ "dir": "Woodlands/!Wilderness/Textures/Dirt", "match": "^Dirt_", "ext": "jpg" }],
    "grass":  [{ "dir": "Woodlands/!Wilderness/Textures/Grass", "match": "^Grass_[A-G]_", "ext": "jpg" }],
    "sand":   [{ "dir": "Volcanic/!Wilderness/Textures/Sand", "match": "^Sand_", "ext": "jpg" }],
    "carpet": [{ "dir": "!Core_Settlements/Textures/Rug_and_Carpets", "match": "^Carpet_", "ext": "jpg" }],
    "tiles":  [{ "dir": "!Core_Settlements/Textures/Stone_Square_Tiles", "match": "^Stone_Square_Tiles_01_", "ext": "jpg" }],
    "water-shallow": [{ "dir": "Swamp/!Wilderness/Textures/Water", "match": "^Water_Still_", "ext": "jpg" }],
    "water-deep":    [{ "dir": "Aquatic/!Wilderness/Textures/Water", "match": "^Water_(A|Opaque)", "ext": "jpg" }],
    "lava":   [{ "dir": "Volcanic/!Wilderness/Textures/Lava", "match": "^Lava_[A-Z]", "ext": "jpg" }]
  }
}
